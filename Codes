2. A* Algorithm for 8 Puzzle Problem
import heapq
def h(state, goal):
    return sum(state[i] != goal[i] and state[i] != 0 for i in range(9))

def puzzle(start, goal):
    pq=[(h(start,goal),0,start,[start])]
    visited=set()
    while pq:
        f,g,state,path=heapq.heappop(pq)
        if state==goal:
            print("Cost:",g)
            print("Path:")
            for p in path:
                print(p)
            return
        visited.add(state)
        i=state.index(0)
        moves=[]
        if i not in [0,1,2]: moves.append(i-3)
        if i not in [6,7,8]: moves.append(i+3)
        if i not in [0,3,6]: moves.append(i-1)
        if i not in [2,5,8]: moves.append(i+1)
        for m in moves:
            new=list(state)
            new[i],new[m]=new[m],new[i]
            new=tuple(new)
            if new not in visited:
                heapq.heappush(pq,(g+1+h(new,goal),g+1,new,path+[new]))

