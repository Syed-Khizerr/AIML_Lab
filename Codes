[0,0,0],
[1,0,1],
[0,0,0]
]
astar_grid(grid,(0,0),(2,2))
4. Graph Coloring using Backtracking
def is_safe(node, color, graph, colors, assignment):
    for n in graph[node]:
        if n in assignment and assignment[n] == color:
            return False
    return True

def solve(graph, colors, assignment):
    if len(assignment) == len(graph):
        print("Solution:", assignment)
        return True
    node = [n for n in graph if n not in assignment][0]
    for color in colors:
        if is_safe(node, color, graph, colors, assignment):
            assignment[node] = color
            if solve(graph, colors, assignment):
                return True
            del assignment[node]

