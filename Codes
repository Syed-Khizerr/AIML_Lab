8. Constraint Satisfaction Problem (Backtracking)
def backtrack(a, vars, dom, cons):
    if len(a) == len(vars): return a
    v = [x for x in vars if x not in a][0]

    for val in dom[v]:
        if all(c(a, v, val) for c in cons):
            a[v] = val
            r = backtrack(a, vars, dom, cons)
            if r: return r
            del a[v]
    return None

def diff(a, v, val):
    return all(val != x for x in a.values())

