1. A* Search on Graph
import heapq
def astar_graph(graph, h, start, goal):
    pq = [(h[start], 0, start, [start])]
    while pq:
        f, g, node, path = heapq.heappop(pq)
        if node == goal:
            print("Path:", path)
            print("Cost:", g)
            return
        for n, w in graph[node]:
            heapq.heappush(pq, (g+w+h[n], g+w, n, path+[n]))

