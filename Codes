3. A* Algorithm for Grid Path Finding
import heapq
def astar_grid(grid,start,goal):
    pq=[(0,0,start,[start])]
    r,c=len(grid),len(grid[0])
    while pq:
        f,g,(x,y),path=heapq.heappop(pq)
        if (x,y)==goal:
            print("Path:",path)
            print("Cost:",g)
            return
        for dx,dy in [(0,1),(1,0),(0,-1),(-1,0)]:
            nx,ny=x+dx,y+dy
            if 0<=nx<r and 0<=ny<c and grid[nx][ny]==0:
                h=abs(nx-goal[0])+abs(ny-goal[1])
                heapq.heappush(pq,(g+1+h,g+1,(nx,ny),path+[(nx,ny)]))

